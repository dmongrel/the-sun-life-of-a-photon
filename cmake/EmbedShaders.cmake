# Writes a C source file embedding SPIR-V blobs, for src/render/shaders_embedded.h to look up.
# Run as a script:
#   cmake -DOUT=<out.c> -DSPVS=<a.spv,b.spv,...> -P EmbedShaders.cmake
#
# The list is comma-separated because a ';' would not survive the custom command's quoting.
# Each blob is named after its source shader with the .spv stripped: "fullscreen.vert".
# Done in CMake itself so the build needs no sh or xxd.

if(NOT OUT OR NOT SPVS)
    message(FATAL_ERROR "usage: cmake -DOUT=<out.c> -DSPVS=<a.spv,b.spv,...> -P EmbedShaders.cmake")
endif()

string(REPLACE "," ";" SPVS "${SPVS}")

# CMake's regular expressions have no {n} repeat, so the sixteen-byte group is spelled out.
string(REPEAT "0x..," 16 line_of_16)

set(arrays "")
set(table "")
set(count 0)
foreach(spv IN LISTS SPVS)
    get_filename_component(name "${spv}" NAME)
    string(REGEX REPLACE "\\.spv$" "" name "${name}")
    string(MAKE_C_IDENTIFIER "spv_${name}" sym)

    file(READ "${spv}" hex HEX)
    # Sixteen bytes to a line, so a compiler diagnostic in the generated file stays readable.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${line_of_16})" "\\1\n    " bytes "${bytes}")

    string(APPEND arrays "static const unsigned char ${sym}[] = {\n    ${bytes}\n};\n\n")
    string(APPEND table "    { \"${name}\", ${sym}, sizeof(${sym}) },\n")
    math(EXPR count "${count} + 1")
endforeach()

file(WRITE "${OUT}"
    "/* Generated by cmake/EmbedShaders.cmake. Do not edit. */\n"
    "#include \"render/shaders_embedded.h\"\n\n"
    "${arrays}"
    "const ShaderBlob g_shaders[] = {\n${table}};\n\n"
    "const unsigned g_shader_count = ${count};\n")
